# Phase 0. Fill in .env (git-ignored). Never commit real values.
# Comma-separated X Layer mainnet RPC URLs (read-only). Empty = SDK defaults (OKX + dRPC).
RPC_URLS_196=
# Public X Layer site used for read-only proofs
XLAYER_SITE=1.2.396.tape
# Proofs 4 to 6 (testnet 1952 only, test keys only). Not used before approval.
TESTNET_PRIVATE_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Receiver wallet for the paid demo: an ADDRESS only (0x + 40 hex), never a key. Must differ from the payer.
PAY_TO_ADDRESS=
# Optional testnet RPC for balance reads (default: viem's https://xlayertestrpc.okx.com)
RPC_URLS_1952=

# Phase 1 backend
PORT=3000
NODE_ENV=development
# Postgres (docker compose: 127.0.0.1:5433). Tests use TEST_DATABASE_URL (database tapehermes_test).
DATABASE_URL=
TEST_DATABASE_URL=
# Redis (docker compose: 127.0.0.1:6380). Every key starts with REDIS_PREFIX.
REDIS_URL=
REDIS_PREFIX=tapehermes:
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=
# Salt for hashing visitor IPs (rate limits). Any long random string. Never stored in the database.
RATE_LIMIT_SALT=
# The sign-in message is bound to this domain and to chain 196.
AUTH_DOMAIN=localhost
SESSION_TTL_SECONDS=86400
# Public base URL of this API (used in manifests)
PUBLIC_BASE_URL=http://127.0.0.1:3000
# DEV MODE SWITCH. 1 = delegation fields are stored but NOT enforced and manifests are dev-style. Refused when NODE_ENV=production.
UNSAFE_DEV_SKIP_DELEGATION=1
TRUST_PROXY_HOPS=0
PROVIDER_CACHE_MAX=100

# Phase 2: x402 network for paid routes (eip155:1952 testnet, eip155:196 mainnet). Settle mode is always sync.
X402_NETWORK=eip155:1952
# OKX facilitator credentials are the OKX_* values above. Optional base URL override:
OKX_FACILITATOR_URL=
# Delegation counts as expiring at this many days left
EXPIRING_DAYS=7

# Phase 3: origins allowed to call /api from a browser (the dashboard), comma separated. https only outside localhost.
CORS_ORIGINS=
