# TapeHermes backend: production settings. Copy to /opt/apps/tapehermes/.env on the server, then replace every CHANGE_ME.
# Rules for this file (docker compose and docker run --env-file both read it):
#  - no quotes around values, no comments after a value, no empty VAR= lines (delete optional lines you do not need)
#  - values must not contain the dollar sign
#  - never commit the filled-in file; chmod 600 on the server
# HOST and PORT are also pinned in compose.yml.

# ---- Server (required) ----
NODE_ENV=production
PORT=3006
HOST=0.0.0.0
# One reverse proxy (Caddy) sits in front, so trust exactly one hop for the visitor address.
TRUST_PROXY_HOPS=1
# The public https address of this API. It is written into every published manifest.
PUBLIC_BASE_URL=https://api.tapehermes.xyz
# The host (and port, if any) of the dashboard where owners sign in. The sign-in message is bound to it.
AUTH_DOMAIN=CHANGE_ME_dashboard_host
# Optional. Origins allowed to call /api from a browser: comma separated, https only, no path, no trailing slash.
# Delete the next line if no dashboard is served from the internet yet.
CORS_ORIGINS=https://CHANGE_ME_dashboard_host

# ---- Database and cache (required) ----
# Passwords: letters and digits only (or percent-encoded), and no dollar sign.
DATABASE_URL=postgresql://tapehermes_user:CHANGE_ME_DB_PASSWORD@postgres:5432/tapehermes_db
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
# Every Redis key starts with this prefix (the Redis server is shared).
REDIS_PREFIX=tapehermes:

# ---- Secrets (required) ----
# VAULT_MASTER_KEY: 32 random bytes, base64. Create it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# It encrypts every stored secret and every site signing key. It must NEVER change after launch.
# Back it up somewhere safe and offline now: lose it and every stored secret is gone for good.
VAULT_MASTER_KEY=CHANGE_ME_base64_32_bytes
# RATE_LIMIT_SALT: any random string of 16 characters or more. Create it with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Changing it only resets the rate-limit counters.
RATE_LIMIT_SALT=CHANGE_ME_random_hex_string

# ---- X Layer (required) ----
# Mainnet RPC URLs, comma separated, read only.
RPC_URLS_196=https://rpc.xlayer.tech,https://xlayerrpc.okx.com

# ---- Paid routes ----
# eip155:196 is X Layer mainnet (real money). eip155:1952 is the testnet.
X402_NETWORK=eip155:196
# Optional. OKX facilitator credentials. Without all three, free routes work and paid routes answer 503.
# Delete these three lines if you do not take payments yet. Do not leave them empty.
OKX_API_KEY=CHANGE_ME_okx_api_key
OKX_SECRET_KEY=CHANGE_ME_okx_secret_key
OKX_PASSPHRASE=CHANGE_ME_okx_passphrase

# ---- Tuning (optional, these are the defaults) ----
SESSION_TTL_SECONDS=86400
EXPIRING_DAYS=7
PROVIDER_CACHE_MAX=100
