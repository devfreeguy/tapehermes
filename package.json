{
  "name": "tapehermes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "proof:1": "pnpm build && node dist/proofs/1-esm-in-nest.js",
    "proof:2": "pnpm build && node dist/proofs/2-two-signers.js",
    "proof:3": "pnpm build && node dist/proofs/3-signed-answer-196.js",
    "proof:4": "pnpm build && node dist/proofs/4-dynamic-payto-offline.js",
    "proof:7": "pnpm build && node dist/proofs/7-cors.js",
    "proof:8": "pnpm build && node dist/proofs/8-publish-manifest-sim.js",
    "proof:5": "pnpm build && node dist/proofs/5-pay-script.js",
    "proof:5:page-build": "esbuild proofs/browser/pay.ts --bundle --outfile=proofs/browser/dist/pay.js --platform=browser --format=iife --alias:crypto=./proofs/browser/no-crypto.ts --log-level=warning",
    "proof:5:serve": "pnpm build && pnpm proof:5:page-build && node dist/proofs/5-serve-browser-page.js",
    "proof:9": "pnpm build && node dist/proofs/9-two-receivers-and-gas.js",
    "proof:10": "pnpm build && node dist/proofs/10-fresh-wallet-pays.js",
    "start": "pnpm build && node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "helper:build": "esbuild helper/tapehermes.js --bundle --minify --format=esm --target=es2022 --platform=browser --legal-comments=none --outfile=helper/dist/tapehermes.min.js --log-level=warning && esbuild helper/tapehermes.js --bundle --minify --format=iife --target=es2022 --platform=browser --legal-comments=none --outfile=helper/dist/tapehermes.iife.min.js --log-level=warning",
    "helper:size": "node helper/size.mjs",
    "phase2:testnet": "pnpm helper:build && pnpm build && node dist/proofs/11-phase2-testnet.js",
    "demo:build": "pnpm helper:build && node demo-site/build.mjs",
    "demo:dev": "pnpm demo:build && pnpm build && node dist/proofs/12-demo-dev.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@okxweb3/x402-core": "0.1.0",
    "@okxweb3/x402-evm": "0.2.1",
    "@okxweb3/x402-express": "0.1.1",
    "@okxweb3/x402-fetch": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tapeapi/sdk": "file:./vendor/tapeapi-3.0.0/tapeapi-sdk-3.0.0.tgz",
    "@tapeapi/server": "file:./vendor/tapeapi-3.0.0/tapeapi-server-3.0.0.tgz",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "8.12.4",
    "viem": "^2.57.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
